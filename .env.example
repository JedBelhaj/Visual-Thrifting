# --- Local development ---
DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\""

# --- Production (Vercel) — set these in the Vercel project, not here ---
# DATABASE_URL        -> Neon Postgres connection string (non-pooled)
# AUTH_SECRET         -> a long random string (same command as above)
# BLOB_READ_WRITE_TOKEN -> from Vercel Blob; when set, uploads go to Blob
#                          instead of ./public/uploads
